<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ★★★ AM-012 §5.2 و§6 (ADR-0024 ⏳ مقترح): الدخولُ ببصمة الإصبع.

         ★ USE_BIOMETRIC إذنٌ من فئة «عادي» (Normal) يُمنَح عند التثبيت
           ⛔ بلا حوارِ وقتِ تشغيلٍ يراه المستخدم، ⟵ فلا يُضاف بابُ إذنٍ
           رابع: ★ والأذونات المعتمدة في dependency-management-policy §3
           (جهات الاتصال · التخزين) تبقى كما هي بلا مساس.

         ⚠️ ومتاحٌ منذ API 28 — ★ وأرضيةُ المشروع 24 (AM-011):
           ⟵ فالإصداراتُ الأقدم تتجاهله بلا ضرر، ★ و`local_auth` تسقط إلى
           FINGERPRINT الملغى داخلياً، ⛔ ولا انهيارَ ولا فشلَ بناء.

         ⛔⛔ ولا إذنَ آخر يُضاف مع هذه الميزة — ★ والخزنةُ الآمنة
           (flutter_secure_storage) بلا أي إذن: تكتب في مساحة التطبيق
           ومفتاحُها في Android Keystore. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- ★ AM-002: الاسم الظاهر للتطبيق من مورد واحد (`res/values/strings.xml`)
         لتتجاوزه النكهة التجريبية من مجموعة مصادرها — ⛔ ولا نصّ محفور هنا. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- ★★ WU-010 (FR-M20-01): إعلانُ رؤيةٍ لا إذنُ وصول.
             أندرويد 11+ يُخفي الحِزَم المثبَّتة عن التطبيقات، ⟵ فبدون هذه
             الكتلة تُرجِع `canLaunchUrl` قيمة `false` دائماً فيظهر «واتساب
             غير مثبَّت» على جهازٍ مثبَّتٌ عليه فعلاً.
             ⛔ وليست من الأذونات: لا `<uses-permission>` واحدة تُضاف هنا،
             ★ والأذونات المعتمدة تبقى كما هي (dependency-management-policy §3).
             ⛔ ولا إذنَ بلوتوث: الطباعة الحرارية خارج النطاق (ADR-0023). -->
        <!-- ★★ ومخطَّط واتساب صراحةً — ⛔ لا `https` وحده:
             `wa.me` رابطُ `https` يعالجه المتصفحُ دائماً، ⟵ فلا يُقاس غيابُ
             واتساب أبداً ويُفتَح المتصفحُ بدله (رُصد حيّاً 2026-08-30). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <!-- ★★ AM-018: سطور تواصل جهة التطوير في «حول التطبيق» قابلة للنقر
             (docs/19-assets/developer-identity.md §4) — ⟵ وبدون هذين
             الإعلانين تُرجِع `canLaunchUrl`/`launchUrl` تعذّراً على أندرويد
             11+ فيبدو السطرُ معطوباً وهو سليم.
             ⛔ وليست إذناً: لا `<uses-permission>` واحدة تُضاف. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- ★ ومشاركةُ الملف المُصدَّر عبر ورقة النظام — FR-M20-14. -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
